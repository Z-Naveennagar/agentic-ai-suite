{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vitis-result.schema.json",
  "title": "Vitis Execution Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "plan_revision",
    "plan_sha256",
    "status",
    "toolchain_version",
    "commands",
    "artifacts",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "status": {"enum": ["PASS", "FAIL", "DRY_RUN"]},
    "toolchain_version": {"type": "string", "minLength": 1},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "argv",
          "cwd",
          "log",
          "status",
          "exit_code",
          "duration_seconds"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "owner": {
            "enum": [
              "vitis_hls_engineer",
              "vitis_aie_engineer",
              "amd_soc_platform_integrator",
              "vitis_sw_engineer"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "cwd": {"type": "string", "minLength": 1},
          "log": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "SKIPPED"]},
          "exit_code": {"type": ["integer", "null"]},
          "duration_seconds": {"type": "number", "minimum": 0}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "exists", "sha256"],
        "properties": {
          "kind": {
            "enum": [
              "vitis-python-script",
              "xpfm",
              "elf",
              "dtb",
              "xo",
              "libadf",
              "linked-xsa",
              "xclbin",
              "package-directory",
              "log",
              "other"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "exists": {"type": "boolean"},
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "severity", "message", "owner"],
        "properties": {
          "stage": {"type": "string", "minLength": 1},
          "severity": {"enum": ["info", "warning", "error"]},
          "message": {"type": "string", "minLength": 1},
          "owner": {
            "enum": [
              "vitis_hls_engineer",
              "vitis_aie_engineer",
              "amd_soc_platform_integrator",
              "vitis_sw_engineer"
            ]
          }
        }
      }
    }
  }
}
