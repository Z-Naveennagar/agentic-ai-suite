{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-manifest.schema.json",
  "title": "Source Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "spec_revision",
    "architecture_revision",
    "revision",
    "manifest_kind",
    "component_id",
    "status",
    "top",
    "files",
    "compile_order",
    "elaboration",
    "component_evidence",
    "unresolved"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "spec_revision": {"type": "integer", "minimum": 1},
    "architecture_revision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "manifest_kind": {"enum": ["aggregate", "component"]},
    "component_id": {"type": ["string", "null"]},
    "status": {"enum": ["READY", "BLOCKED", "ERROR"]},
    "top": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "compile_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "elaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tool", "artifacts", "logs"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
        "tool": {"type": ["string", "null"]},
        "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "logs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "component_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"manifest_kind": {"const": "aggregate"}}, "required": ["manifest_kind"]},
      "then": {"properties": {"component_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"manifest_kind": {"const": "component"}}, "required": ["manifest_kind"]},
      "then": {"properties": {"component_id": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "READY"}}, "required": ["status"]},
      "then": {
        "properties": {
          "unresolved": {"maxItems": 0},
          "elaboration": {
            "properties": {"status": {"const": "PASS"}},
            "required": ["status"]
          }
        }
      }
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "language", "owner", "architecture_element", "sha256", "generated"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["rtl", "constraint", "tcl", "ip", "block_design", "hls", "aie", "software", "package", "other"]},
        "language": {"type": ["string", "null"]},
        "owner": {"type": "string", "minLength": 1},
        "architecture_element": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "generated": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "artifacts", "metrics"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["lint", "elaboration", "csim", "hls_synthesis", "cosim", "aie_compile", "software_build", "block_design_validation", "other"]},
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
        "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "metrics": {
          "type": "array",
          "items": {"$ref": "#/$defs/metric"}
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "units"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "boolean"]},
        "units": {"type": ["string", "null"]}
      }
    }
  }
}
