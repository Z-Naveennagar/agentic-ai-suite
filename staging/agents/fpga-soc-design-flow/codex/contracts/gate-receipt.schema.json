{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-receipt.schema.json",
  "title": "Agent Transition Gate Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "gate_id",
    "iteration",
    "stage",
    "mode",
    "opened_at",
    "evaluated_at",
    "producer",
    "consumer",
    "objective",
    "reason",
    "inputs",
    "actions",
    "decisions",
    "claims",
    "outputs",
    "checks",
    "changes",
    "disclosures",
    "assumptions",
    "waivers",
    "unverified_boundaries",
    "side_effects",
    "approval",
    "producer_status",
    "evaluator",
    "verdict",
    "verdict_reasons",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "gate_id": {"type": "string", "pattern": "^GATE-[A-Z0-9_-]+$"},
    "iteration": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["intake", "spec", "architecture", "source", "verification", "vitis", "implementation", "hardware"]},
    "mode": {"enum": ["transparent_automatic", "exception_approval", "approve_every_gate"]},
    "opened_at": {"type": "string", "format": "date-time"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "consumer": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}, "minItems": 1},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}, "minItems": 1},
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "modified", "deleted", "total_created", "total_modified", "total_deleted", "truncated"],
      "properties": {
        "created": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "modified": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "deleted": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "total_created": {"type": "integer", "minimum": 0},
        "total_modified": {"type": "integer", "minimum": 0},
        "total_deleted": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },
    "disclosures": {"type": "array", "items": {"$ref": "#/$defs/disclosure"}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "waivers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unverified_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vivado_project_mutated", "hardware_programmed", "vio_driven", "external_equipment_controlled", "details"],
      "properties": {
        "vivado_project_mutated": {"type": "boolean"},
        "hardware_programmed": {"type": "boolean"},
        "vio_driven": {"type": "boolean"},
        "external_equipment_controlled": {"type": "boolean"},
        "details": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reasons", "status", "granted_by", "granted_at"],
      "properties": {
        "required": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "status": {"enum": ["NOT_REQUIRED", "PENDING", "GRANTED"]},
        "granted_by": {"type": ["string", "null"], "minLength": 1},
        "granted_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "producer_status": {"type": "string", "minLength": 1},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "implementation", "command"],
      "properties": {
        "kind": {"const": "deterministic"},
        "implementation": {"const": "scripts/gate_runner.py"},
        "command": {"type": "string", "minLength": 1}
      }
    },
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "ERROR"]},
    "verdict_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "next_action": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {"const": "PASS"}
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {"const": "PASS"}
              },
              "required": ["status"]
            }
          },
          "approval": {
            "properties": {
              "status": {"enum": ["NOT_REQUIRED", "GRANTED"]}
            },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {"required": {"const": true}},
            "required": ["required"]
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "status": {"enum": ["PENDING", "GRANTED"]}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "revision", "exists", "integrity", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": ["integer", "null"], "minimum": 1},
        "exists": {"type": "boolean"},
        "integrity": {"enum": ["PINNED", "OBSERVED"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"integrity": {"const": "PINNED"}, "exists": {"const": true}}, "required": ["integrity", "exists"]},
          "then": {"properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_ids", "selected", "alternatives", "rationale", "confidence", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "selected": {"type": "string", "minLength": 1},
        "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rationale": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "requirement_ids", "evidence", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "ERROR", "NOT_VERIFIED"]}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description", "mandatory", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["authority", "schema", "revision", "integrity", "requirements", "architecture", "elaboration", "verification", "implementation", "hardware", "approval", "other"]},
        "description": {"type": "string", "minLength": 1},
        "mandatory": {"type": "boolean"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "ERROR"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "source"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "integer", "boolean", "null"]},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
