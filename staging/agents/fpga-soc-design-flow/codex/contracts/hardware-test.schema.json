{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware-test.schema.json",
  "title": "Portable Hardware Test Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "revision",
    "status",
    "owner",
    "standard_profile",
    "target",
    "required_capabilities",
    "programming",
    "stimulus",
    "instrumentation",
    "test_sequence",
    "pass_criteria",
    "cleanup",
    "external_equipment"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["READY", "BLOCKED"]},
    "owner": {"const": "amd_soc_hardware_validator"},
    "standard_profile": {"const": "portable-vio-ila-v1"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "board_part"],
      "properties": {
        "part": {"type": "string", "minLength": 1},
        "board_part": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ssh",
          "jtag",
          "vivado_hw_manager",
          "linux_fpga_manager",
          "ila",
          "vio",
          "jtag_axi",
          "ps_software",
          "dma",
          "onchip_generator",
          "external_equipment"
        ]
      },
      "allOf": [
        {"contains": {"const": "ila"}},
        {"contains": {"const": "vio"}}
      ]
    },
    "programming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_backends", "require_matching_ltx", "requires_xsa"],
      "properties": {
        "accepted_backends": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["vivado_hw_manager", "linux_fpga_manager"]}
        },
        "require_matching_ltx": {"const": true},
        "requires_xsa": {"type": "boolean"}
      }
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "control_plane", "data_plane", "seed", "description"],
      "properties": {
        "adapter": {
          "enum": [
            "vio_native",
            "dual_clock_vio",
            "jtag_axi",
            "ps_axi",
            "ps_dma",
            "onchip_video_generator",
            "external_video_with_synthetic_fallback"
          ]
        },
        "control_plane": {"enum": ["vio", "jtag_axi", "ssh"]},
        "data_plane": {"enum": ["vio", "jtag_axi", "dma", "onchip_generator", "external_equipment"]},
        "seed": {"type": "integer", "minimum": 0},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "instrumentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vio_cores", "ila_cores", "debug_map_required"],
      "properties": {
        "vio_cores": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/vio_core"}
        },
        "ila_cores": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ila_core"}
        },
        "debug_map_required": {"const": true}
      }
    },
    "test_sequence": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/action"}
    },
    "pass_criteria": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "actions"],
      "properties": {
        "required": {"const": true},
        "actions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["reset_vio_outputs", "stop_test_software", "remove_overlay", "restore_safe_state"]}
        }
      }
    },
    "external_equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target_kind", "required", "required_capabilities", "purpose"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "target_kind": {
            "enum": [
              "camera",
              "audio_codec",
              "audio_source",
              "audio_sink",
              "display",
              "network",
              "storage",
              "sensor",
              "external_equipment"
            ]
          },
          "required": {"type": "boolean"},
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
          },
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "width": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 4096},
        {"type": "string", "minLength": 1}
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "source", "purpose"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "width": {"$ref": "#/$defs/width"},
        "source": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "control_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "source", "purpose", "safe_initial_value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "width": {"$ref": "#/$defs/width"},
        "source": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "safe_initial_value": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"}
      }
    },
    "vio_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clock_domain", "controls", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^VIO-[A-Z0-9_-]+$"},
        "clock_domain": {"type": "string", "minLength": 1},
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/control_probe"}
        },
        "status": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/probe"}
        }
      }
    },
    "ila_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "source", "purpose", "role"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "width": {"$ref": "#/$defs/width"},
        "source": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "role": {"enum": ["trigger", "data", "protocol", "status"]}
      }
    },
    "ila_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clock_domain", "kind", "depth", "probes", "trigger"],
      "properties": {
        "id": {"type": "string", "pattern": "^ILA-[A-Z0-9_-]+$"},
        "clock_domain": {"type": "string", "minLength": 1},
        "kind": {"enum": ["ila", "system_ila"]},
        "depth": {"type": "integer", "minimum": 1024, "maximum": 131072},
        "probes": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/ila_probe"}
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe", "condition", "position"],
          "properties": {
            "probe": {"type": "string", "minLength": 1},
            "condition": {"type": "string", "minLength": 1},
            "position": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "timeout_seconds", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^HW-ACT-[A-Z0-9_-]+$"},
        "action": {
          "enum": [
            "precheck_target",
            "quiesce",
            "program",
            "refresh_debug",
            "reset_vio",
            "capture_immediate",
            "configure_stimulus",
            "arm_ila",
            "start",
            "wait_done",
            "read_status",
            "upload_ila",
            "evaluate",
            "cleanup"
          ]
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mandatory", "measurement", "operator", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^HW-CRIT-[A-Z0-9_-]+$"},
        "mandatory": {"type": "boolean"},
        "measurement": {"type": "string", "minLength": 1},
        "operator": {"enum": ["equals", "not_equals", "greater_or_equal", "less_or_equal", "exists"]},
        "expected": {"type": ["string", "number", "integer", "boolean", "null"]}
      }
    }
  }
}
