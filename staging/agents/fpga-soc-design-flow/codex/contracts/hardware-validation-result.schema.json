{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware-validation-result.schema.json",
  "title": "Hardware Validation Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "spec_revision",
    "architecture_revision",
    "source_revision",
    "verification_revision",
    "implementation_revision",
    "hardware_test_revision",
    "revision",
    "status",
    "target_profile_id",
    "authorization",
    "connections",
    "identity",
    "programming",
    "debug_cores",
    "tests",
    "captures",
    "artifacts",
    "findings",
    "cleanup",
    "feedback"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "spec_revision": {"type": "integer", "minimum": 1},
    "architecture_revision": {"type": "integer", "minimum": 1},
    "source_revision": {"type": "integer", "minimum": 1},
    "verification_revision": {"type": "integer", "minimum": 1},
    "implementation_revision": {"type": "integer", "minimum": 1},
    "hardware_test_revision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["PASS", "FAIL", "ERROR", "BLOCKED"]},
    "target_profile_id": {"type": "string", "minLength": 1},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programming", "probe_drive", "granted_by", "granted_at"],
      "properties": {
        "programming": {"type": "boolean"},
        "probe_drive": {"type": "boolean"},
        "granted_by": {"type": ["string", "null"], "minLength": 1},
        "granted_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "endpoint", "status", "evidence"],
        "properties": {
          "adapter": {"enum": ["ssh_linux", "vivado_hw_manager", "linux_fpga_manager", "external_equipment"]},
          "endpoint": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "SKIP", "ERROR"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "board_part", "target_name", "device_dna"],
      "properties": {
        "part": {"type": "string", "minLength": 1},
        "board_part": {"type": ["string", "null"], "minLength": 1},
        "target_name": {"type": "string", "minLength": 1},
        "device_dna": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "programming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "image", "image_sha256", "probes_file", "probes_sha256", "status"],
      "properties": {
        "backend": {"enum": ["vivado_hw_manager", "linux_fpga_manager"]},
        "image": {"type": "string", "minLength": 1},
        "image_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "probes_file": {"type": ["string", "null"], "minLength": 1},
        "probes_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "status": {"enum": ["PASS", "FAIL", "ERROR", "NOT_RUN"]}
      }
    },
    "debug_cores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "clock_domain", "probes"],
        "properties": {
          "kind": {"enum": ["ila", "vio"]},
          "name": {"type": "string", "minLength": 1},
          "clock_domain": {"type": "string", "minLength": 1},
          "probes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "width", "type"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "width": {"type": "integer", "minimum": 1},
                "type": {"enum": ["ila", "vio_input", "vio_output"]}
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "started_at", "completed_at", "measurements", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "ERROR", "SKIP"]},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"},
          "measurements": {
            "type": "object",
            "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
          },
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["core", "path", "format", "trigger", "sample_count", "sha256"],
        "properties": {
          "core": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "format": {"enum": ["csv", "vcd", "ila"]},
          "trigger": {"type": "string", "minLength": 1},
          "sample_count": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "exists", "sha256"],
        "properties": {
          "kind": {"enum": ["log", "json", "csv", "vcd", "ila", "other"]},
          "path": {"type": "string", "minLength": 1},
          "exists": {"type": "boolean"},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "class", "message", "evidence"],
        "properties": {
          "severity": {"enum": ["info", "warning", "critical"]},
          "class": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actions"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "ERROR", "NOT_RUN"]},
        "actions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "feedback": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "failure_class", "evidence", "requested_action"],
          "properties": {
            "owner": {
              "enum": [
                "amd_soc_orchestrator",
                "amd_soc_intent_to_spec",
                "amd_soc_architect",
                "vivado_rtl_engineer",
                "amd_soc_platform_integrator",
                "vitis_sw_engineer",
                "amd_soc_verifier",
                "vivado_impl_closure",
                "amd_soc_hardware_validator"
              ]
            },
            "failure_class": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "requested_action": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "programming": {"const": true},
              "probe_drive": {"const": true}
            }
          },
          "programming": {
            "properties": {
              "status": {"const": "PASS"},
              "probes_file": {"type": "string", "minLength": 1},
              "probes_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          },
          "debug_cores": {
            "minItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {"kind": {"const": "ila"}},
                  "required": ["kind"]
                }
              },
              {
                "contains": {
                  "properties": {"kind": {"const": "vio"}},
                  "required": ["kind"]
                }
              }
            ]
          },
          "tests": {
            "items": {
              "properties": {"status": {"const": "PASS"}}
            }
          },
          "captures": {"minItems": 1},
          "cleanup": {
            "properties": {"status": {"const": "PASS"}}
          },
          "feedback": {"type": "null"}
        }
      }
    }
  ]
}
