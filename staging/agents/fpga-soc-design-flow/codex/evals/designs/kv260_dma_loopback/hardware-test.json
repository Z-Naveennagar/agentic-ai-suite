{
  "case_id": "kv260_dma_loopback",
  "cleanup": {
    "actions": [
      "reset_vio_outputs",
      "stop_test_software",
      "restore_safe_state"
    ],
    "required": true
  },
  "external_equipment": [],
  "instrumentation": {
    "debug_map_required": true,
    "ila_cores": [
      {
        "clock_domain": "clk",
        "depth": 1024,
        "id": "ILA-HW-TEST-0",
        "kind": "system_ila",
        "probes": [
          {
            "name": "hw_test_start",
            "purpose": "Trigger on the accepted test start.",
            "role": "trigger",
            "source": "hardware test shell",
            "width": 1
          },
          {
            "name": "hw_test_activity",
            "purpose": "Show cycle-accurate DUT activity in this clock domain.",
            "role": "data",
            "source": "kv260_dma_loopback",
            "width": 1
          },
          {
            "name": "hw_test_done",
            "purpose": "Correlate completion with observed activity.",
            "role": "status",
            "source": "hardware test shell",
            "width": 1
          },
          {
            "name": "hw_test_pass",
            "purpose": "Capture the final self-check result.",
            "role": "status",
            "source": "hardware test shell",
            "width": 1
          },
          {
            "name": "hw_test_error_code",
            "purpose": "Capture deterministic failure classification.",
            "role": "status",
            "source": "hardware test shell",
            "width": 16
          }
        ],
        "trigger": {
          "condition": "eq1'bR",
          "position": 128,
          "probe": "hw_test_start"
        }
      }
    ],
    "vio_cores": [
      {
        "clock_domain": "clk",
        "controls": [
          {
            "name": "hw_test_reset",
            "purpose": "Hold the test shell in a known safe state.",
            "safe_initial_value": "0x1",
            "source": "hardware test shell",
            "width": 1
          },
          {
            "name": "hw_test_start",
            "purpose": "Start one deterministic self-test transaction.",
            "safe_initial_value": "0x0",
            "source": "hardware test shell",
            "width": 1
          },
          {
            "name": "hw_test_enable",
            "purpose": "Enable stimulus generation without changing the public DUT interface.",
            "safe_initial_value": "0x0",
            "source": "hardware test shell",
            "width": 1
          }
        ],
        "id": "VIO-HW-TEST-0",
        "status": [
          {
            "name": "hw_test_busy",
            "purpose": "Report an active hardware test.",
            "source": "hardware test shell",
            "width": 1
          },
          {
            "name": "hw_test_done",
            "purpose": "Report bounded test completion.",
            "source": "hardware test shell",
            "width": 1
          },
          {
            "name": "hw_test_pass",
            "purpose": "Report aggregate mandatory-criterion status.",
            "source": "hardware test shell",
            "width": 1
          },
          {
            "name": "hw_test_error_code",
            "purpose": "Identify the first failed hardware criterion.",
            "source": "hardware test shell",
            "width": 16
          }
        ]
      }
    ]
  },
  "owner": "amd_soc_hardware_validator",
  "pass_criteria": [
    {
      "expected": true,
      "id": "HW-CRIT-TARGET",
      "mandatory": true,
      "measurement": "target.part_matches",
      "operator": "equals"
    },
    {
      "expected": true,
      "id": "HW-CRIT-DEBUG",
      "mandatory": true,
      "measurement": "debug.required_cores_present",
      "operator": "equals"
    },
    {
      "expected": 1,
      "id": "HW-CRIT-IMMEDIATE",
      "mandatory": true,
      "measurement": "ila.immediate_capture_samples",
      "operator": "greater_or_equal"
    },
    {
      "expected": 1,
      "id": "HW-CRIT-DONE",
      "mandatory": true,
      "measurement": "vio.hw_test_done",
      "operator": "equals"
    },
    {
      "expected": 1,
      "id": "HW-CRIT-PASS",
      "mandatory": true,
      "measurement": "vio.hw_test_pass",
      "operator": "equals"
    },
    {
      "expected": 0,
      "id": "HW-CRIT-ERROR",
      "mandatory": true,
      "measurement": "vio.hw_test_error_code",
      "operator": "equals"
    },
    {
      "expected": true,
      "id": "HW-CRIT-CAPTURE",
      "mandatory": true,
      "measurement": "ila.functional_capture",
      "operator": "exists"
    }
  ],
  "programming": {
    "accepted_backends": [
      "vivado_hw_manager",
      "linux_fpga_manager"
    ],
    "require_matching_ltx": true,
    "requires_xsa": true
  },
  "required_capabilities": [
    "jtag",
    "vivado_hw_manager",
    "ila",
    "vio",
    "ssh",
    "ps_software",
    "dma"
  ],
  "revision": 1,
  "schema_version": 1,
  "standard_profile": "portable-vio-ila-v1",
  "status": "READY",
  "stimulus": {
    "adapter": "ps_dma",
    "control_plane": "ssh",
    "data_plane": "dma",
    "description": "Use PS software and DMA for deterministic high-rate traffic; VIO starts the test shell and System ILA observes the data path.",
    "seed": 1
  },
  "target": {
    "board_part": "xilinx.com:kv260_som:part0:1.4",
    "part": "xck26-sfvc784-2LV-c"
  },
  "test_sequence": [
    {
      "action": "precheck_target",
      "description": "Verify target identity, declared capabilities, and artifact hashes.",
      "id": "HW-ACT-PRECHECK",
      "timeout_seconds": 30
    },
    {
      "action": "quiesce",
      "description": "Stop or isolate software and drivers that can access the PL.",
      "id": "HW-ACT-QUIESCE",
      "timeout_seconds": 30
    },
    {
      "action": "program",
      "description": "Program the authorized image through the selected backend.",
      "id": "HW-ACT-PROGRAM",
      "timeout_seconds": 120
    },
    {
      "action": "refresh_debug",
      "description": "Associate the matching .ltx and inventory actual debug cores and probes.",
      "id": "HW-ACT-REFRESH",
      "timeout_seconds": 30
    },
    {
      "action": "reset_vio",
      "description": "Synchronize and reset VIO outputs to safe initial values.",
      "id": "HW-ACT-RESET",
      "timeout_seconds": 10
    },
    {
      "action": "capture_immediate",
      "description": "Run a bounded immediate ILA capture as a debug-connectivity check.",
      "id": "HW-ACT-IMMEDIATE",
      "timeout_seconds": 60
    },
    {
      "action": "configure_stimulus",
      "description": "Configure the deterministic stimulus adapter and seed.",
      "id": "HW-ACT-CONFIGURE",
      "timeout_seconds": 30
    },
    {
      "action": "arm_ila",
      "description": "Configure and arm the functional ILA trigger.",
      "id": "HW-ACT-ARM",
      "timeout_seconds": 30
    },
    {
      "action": "start",
      "description": "Drive the VIO start transition in a separate Hardware Manager operation.",
      "id": "HW-ACT-START",
      "timeout_seconds": 10
    },
    {
      "action": "wait_done",
      "description": "Wait for bounded VIO or software completion.",
      "id": "HW-ACT-WAIT",
      "timeout_seconds": 120
    },
    {
      "action": "read_status",
      "description": "Read busy, done, pass, and error-code status.",
      "id": "HW-ACT-STATUS",
      "timeout_seconds": 30
    },
    {
      "action": "upload_ila",
      "description": "Upload and export ILA capture data.",
      "id": "HW-ACT-UPLOAD",
      "timeout_seconds": 60
    },
    {
      "action": "evaluate",
      "description": "Evaluate every mandatory criterion independently.",
      "id": "HW-ACT-EVALUATE",
      "timeout_seconds": 30
    },
    {
      "action": "cleanup",
      "description": "Restore safe VIO values and stop test software.",
      "id": "HW-ACT-CLEANUP",
      "timeout_seconds": 30
    }
  ]
}
