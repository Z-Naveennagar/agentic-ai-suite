{
  "schema_version": 1,
  "case_id": "kv260_i2s_transmitter",
  "revision": 1,
  "status": "READY",
  "owner": "amd_soc_hardware_validator",
  "standard_profile": "portable-vio-ila-v1",
  "target": {"part": "xck26-sfvc784-2LV-c", "board_part": "xilinx.com:kv260_som:part0:1.4"},
  "required_capabilities": ["jtag", "vivado_hw_manager", "ila", "vio"],
  "programming": {
    "accepted_backends": ["vivado_hw_manager", "linux_fpga_manager"],
    "require_matching_ltx": true,
    "requires_xsa": true
  },
  "stimulus": {
    "adapter": "vio_native",
    "control_plane": "vio",
    "data_plane": "vio",
    "seed": 21,
    "description": "VIO starts a deterministic stereo-frame generator; ILA captures BCLK, LRCLK, and serial activity."
  },
  "instrumentation": {
    "debug_map_required": true,
    "vio_cores": [{
      "id": "VIO-HW-TEST-0",
      "clock_domain": "clk",
      "controls": [
        {"name": "hw_test_reset", "width": 1, "source": "hardware test shell", "purpose": "Hold the shell in reset.", "safe_initial_value": "0x1"},
        {"name": "hw_test_start", "width": 1, "source": "hardware test shell", "purpose": "Start one stereo-frame test.", "safe_initial_value": "0x0"},
        {"name": "hw_test_enable", "width": 1, "source": "hardware test shell", "purpose": "Enable serial stimulus.", "safe_initial_value": "0x0"}
      ],
      "status": [
        {"name": "hw_test_busy", "width": 1, "source": "hardware test shell", "purpose": "Report active test."},
        {"name": "hw_test_done", "width": 1, "source": "hardware test shell", "purpose": "Report bounded completion."},
        {"name": "hw_test_pass", "width": 1, "source": "hardware test shell", "purpose": "Report aggregate pass."},
        {"name": "hw_test_error_code", "width": 16, "source": "hardware test shell", "purpose": "Identify first failure."}
      ]
    }],
    "ila_cores": [{
      "id": "ILA-HW-TEST-0",
      "clock_domain": "clk",
      "kind": "ila",
      "depth": 2048,
      "probes": [
        {"name": "hw_test_start", "width": 1, "source": "hardware test shell", "purpose": "Trigger accepted test start.", "role": "trigger"},
        {"name": "i2s_activity", "width": 3, "source": "kv260_i2s_transmitter", "purpose": "Capture BCLK, LRCLK, and serial data.", "role": "data"},
        {"name": "hw_test_done", "width": 1, "source": "hardware test shell", "purpose": "Correlate completion.", "role": "status"},
        {"name": "hw_test_pass", "width": 1, "source": "hardware test shell", "purpose": "Capture self-check result.", "role": "status"},
        {"name": "hw_test_error_code", "width": 16, "source": "hardware test shell", "purpose": "Capture failure class.", "role": "status"}
      ],
      "trigger": {"probe": "hw_test_start", "condition": "eq1'bR", "position": 256}
    }]
  },
  "test_sequence": [
    {"id": "HW-ACT-PRECHECK", "action": "precheck_target", "timeout_seconds": 30, "description": "Verify target and artifact hashes."},
    {"id": "HW-ACT-QUIESCE", "action": "quiesce", "timeout_seconds": 30, "description": "Quiesce PL clients."},
    {"id": "HW-ACT-PROGRAM", "action": "program", "timeout_seconds": 120, "description": "Program the authorized image."},
    {"id": "HW-ACT-REFRESH", "action": "refresh_debug", "timeout_seconds": 30, "description": "Associate matching LTX and debug cores."},
    {"id": "HW-ACT-RESET", "action": "reset_vio", "timeout_seconds": 10, "description": "Apply safe VIO values."},
    {"id": "HW-ACT-CAPTURE", "action": "capture_immediate", "timeout_seconds": 60, "description": "Confirm ILA connectivity."},
    {"id": "HW-ACT-CONFIGURE", "action": "configure_stimulus", "timeout_seconds": 30, "description": "Load deterministic stereo samples."},
    {"id": "HW-ACT-ARM", "action": "arm_ila", "timeout_seconds": 30, "description": "Arm the functional trigger."},
    {"id": "HW-ACT-START", "action": "start", "timeout_seconds": 10, "description": "Pulse VIO start."},
    {"id": "HW-ACT-WAIT", "action": "wait_done", "timeout_seconds": 120, "description": "Wait for bounded completion."},
    {"id": "HW-ACT-EVALUATE", "action": "evaluate", "timeout_seconds": 30, "description": "Check serialized frame and status."},
    {"id": "HW-ACT-CLEANUP", "action": "cleanup", "timeout_seconds": 30, "description": "Restore safe state."}
  ],
  "pass_criteria": [
    {"id": "HW-CRIT-TARGET", "mandatory": true, "measurement": "target.part_matches", "operator": "equals", "expected": true},
    {"id": "HW-CRIT-DEBUG", "mandatory": true, "measurement": "debug.required_cores_present", "operator": "equals", "expected": true},
    {"id": "HW-CRIT-DONE", "mandatory": true, "measurement": "vio.hw_test_done", "operator": "equals", "expected": 1},
    {"id": "HW-CRIT-PASS", "mandatory": true, "measurement": "vio.hw_test_pass", "operator": "equals", "expected": 1},
    {"id": "HW-CRIT-ERROR", "mandatory": true, "measurement": "vio.hw_test_error_code", "operator": "equals", "expected": 0},
    {"id": "HW-CRIT-CAPTURE", "mandatory": true, "measurement": "ila.functional_capture", "operator": "exists", "expected": true}
  ],
  "cleanup": {"required": true, "actions": ["reset_vio_outputs", "restore_safe_state"]},
  "external_equipment": []
}
